<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ProgressBar?>

<StackPane fx:id="rootPane" style="-fx-background-color: #1b2838;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.centurionlauncher.controller.GameDetailController">
    <children>
        <BorderPane fx:id="mainContentPane" visible="false">
            <top>
                <VBox>
                    

                    <ImageView fx:id="gameHeaderImageView" fitHeight="300.0" pickOnBounds="true" preserveRatio="true" />
                    
                    <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 50 15 50; -fx-background-color: rgba(0,0,0,0.2);">
                        <children>
                            <VBox spacing="10.0">
                                <children>
                                    <Button fx:id="playButton" mnemonicParsing="false" onAction="#handlePlayButtonAction" prefHeight="50.0" prefWidth="180.0" styleClass="play-button" text="INSTALL" />
                                    <VBox fx:id="installProgressBox" alignment="CENTER_LEFT" managed="false" spacing="5.0" visible="false">
                                        <children>
                                            <Label fx:id="installStatusLabel" style="-fx-text-fill: white;" text="Installing" />
                                            <ProgressBar fx:id="installProgressBar" prefWidth="180.0" progress="0.0" />
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                            <VBox>
                                <children>
                                    <Label styleClass="info-label-header" text="LAST PLAYED" />
                                    <Label fx:id="lastPlayedLabel" styleClass="info-label-content" text="Never" />
                                </children>
                            </VBox>
                            <VBox>
                                <children>
                                    <Label styleClass="info-label-header" text="PLAYTIME" />
                                    <Label fx:id="playTimeLabel" styleClass="info-label-content" text="0 hours" />
                                </children>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="10.0">
                                <children>
                                <Button fx:id="uninstallButton" mnemonicParsing="false" onAction="#handleUninstallButtonAction" styleClass="uninstall-button" text="Uninstall" />
                                </children>
                            </HBox>
                        </children>
                    </HBox>
                </VBox>
            </top>
            <center>
                <HBox spacing="20.0" BorderPane.alignment="CENTER">
                    <children>
                        <VBox prefWidth="750.0" spacing="20.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="gameTitleLabel" styleClass="game-title" text="Game Title" />
                                <Label fx:id="gameDescriptionLabel" styleClass="game-description" text="Description loading..." wrapText="true" />
                            </children>
                        </VBox>
                        <VBox minWidth="350.0" prefWidth="350.0" spacing="15.0" styleClass="right-sidebar">
                            <children>
                                <Label styleClass="sidebar-header" text="FRIENDS WHO PLAY" />
                                <Label styleClass="sidebar-header" text="MY REVIEW" />
                                <Label fx:id="myReviewLabel" styleClass="sidebar-content" text="You've played for 0 hours" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
                    </padding>
                </HBox>
            </center>
        </BorderPane>
        
        <ProgressIndicator fx:id="loadingIndicator" maxHeight="100" maxWidth="100" visible="true" />
    </children>
</StackPane>
